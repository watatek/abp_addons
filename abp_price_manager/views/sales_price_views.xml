<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sales_price_view_list" model="ir.ui.view">
        <field name="name">sales.price.list</field>
        <field name="model">sales.price</field>
        <field name="arch" type="xml">
            <list string="Price Management" decoration-muted="state == 'inactive'" decoration-success="state == 'active'">
                <field name="name" width="140px"/>
                <field name="product_template_id" width="180px"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="selling_price" width="110px"
                       widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="gross_margin" widget="percentage" width="100px"
                       decoration-danger="gross_margin &lt; 0"/>
                <field name="create_uid" string="Created by" width="60px"
                       widget="many2one_avatar_user"/>
                <field name="approved_by_id" width="60px"
                       widget="many2one_avatar_user"/>
                <field name="approval_date" width="130px"/>
                <field name="state" widget="badge" width="90px"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'active'"
                       decoration-danger="state == 'inactive'"/>
                <button name="action_approve" type="object" string="Approve"
                        icon="fa-check" class="text-success" width="90px"
                        invisible="state != 'submitted'"/>
                <button name="action_decline" type="object" string="Decline"
                        icon="fa-times" class="text-danger" width="90px"
                        invisible="state != 'submitted'"/>
                <button name="action_deactivate" type="object" string="Deactivate"
                        icon="fa-ban" class="text-danger" width="90px"
                        invisible="state != 'active'"/>
            </list>
        </field>
    </record>

    <record id="sales_price_view_form" model="ir.ui.view">
        <field name="name">sales.price.form</field>
        <field name="model">sales.price</field>
        <field name="arch" type="xml">
            <form string="Price">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_decline" type="object" string="Decline"
                            invisible="state != 'submitted'"/>
                    <button name="action_deactivate" type="object" string="Deactivate"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,active,inactive"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Price Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Retail 2026 Q1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Item">
                            <field name="product_template_id"
                                   readonly="state != 'draft'"/>
                            <field name="cost_id" readonly="state != 'draft'"
                                   domain="[('product_template_id', '=', product_template_id)]"/>
                            <field name="create_uid" string="Created by"
                                   widget="many2one_avatar_user" readonly="1"/>
                        </group>
                        <group string="Currency">
                            <field name="currency_id" readonly="state != 'draft'"/>
                            <field name="exchange_rate"/>
                        </group>
                        <group string="Margin">
                            <field name="cost_currency_id" invisible="1"/>
                            <field name="landed_cost" invisible="1"/>
                            <field name="landed_cost_converted" invisible="1"/>
                            <field name="landed_cost_display" readonly="1"/>
                            <field name="gross_margin" widget="percentage" class="fw-bold"/>
                        </group>
                        <group string="Price Components">
                            <field name="exw_price" readonly="state != 'draft'"
                                   widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="processing_price" readonly="state != 'draft'"
                                   widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="freight_price" readonly="state != 'draft'"
                                   widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="selling_price" invisible="1"/>
                            <field name="selling_price_display" readonly="1"
                                   class="fw-bold"/>
                        </group>
                        <group string="Approval">
                            <field name="approved_by_id" widget="many2one_avatar_user"/>
                            <field name="approval_date"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sales_price_view_search" model="ir.ui.view">
        <field name="name">sales.price.search</field>
        <field name="model">sales.price</field>
        <field name="arch" type="xml">
            <search string="Price">
                <field name="name"/>
                <field name="product_template_id"/>
                <field name="cost_id"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="filter_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="filter_inactive" string="Inactive" domain="[('state', '=', 'inactive')]"/>
                <group>
                    <filter name="group_product" string="Item" domain="[]"
                            context="{'group_by': 'product_template_id'}"/>
                    <filter name="group_state" string="Status" domain="[]"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
