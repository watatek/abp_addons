<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_addresss" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//t[@t-set='address']" position="replace">
            <t t-set="address">
                <br/>
                <t t-if="o.set_name">
                    <span>
                        <b>Initial Address</b>
                    </span>
                    <div>
                        <span t-field="o.set_name" class="m-0"/>
                        <br/>
                        <span t-field="o.street" class="m-0"/>
                        <br/>
                        <t t-if="o.street2">
                            <span t-field="o.street2" class="m-0"/>
                            <br/>
                        </t>
                        <span t-field="o.city" class="m-0"/>
                        <span t-field="o.zip" class="m-0"/>
                        <br/>
                        <span t-field="o.country_id" class="m-0"/>
                        <br/>
                        <span></span>
                        <br/>
                    </div>
                </t>
            </t>
        </xpath>

    </template>
    <template id="report_purchasequotation_document" inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//t//t[3]" position="before">
            <br/>
            <t t-if="o.set_name">
                <span>
                    <b>Initial Address</b>
                </span>
                <div>
                    <span t-field="o.set_name" class="m-0"/>
                    <br/>
                    <span t-field="o.street" class="m-0"/>
                    <br/>
                    <t t-if="o.street2">
                        <span t-field="o.street2" class="m-0"/>
                        <br/>
                    </t>
                    <span t-field="o.city" class="m-0"/>
                    <span t-field="o.zip" class="m-0"/>
                    <br/>
                    <span t-field="o.country_id" class="m-0"/>
                    <br/>
                    <span></span>
                    <br/>
                </div>
            </t>
        </xpath>
    </template>

</odoo>
