<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_set_message_wizard_form" model="ir.ui.view">
            <field name="name">Update Address Messages</field>
            <field name="model">set.message.wizard</field>
            <field name="arch" type="xml">
                <form string="Update Address Messages ">
                    <group string="Messages" width="100%">
                    </group>
                    <field name="set_message" nolabel="1" readonly="1"/>
                    <footer>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_set_message_bill_wizard_form" model="ir.ui.view">
            <field name="name">Update Address Messages</field>
            <field name="model">set.message.bill.wizard</field>
            <field name="arch" type="xml">
                <form string="Update Address Messages ">
                    <group string="Messages" width="100%">
                    </group>
                    <field name="set_message" nolabel="1" readonly="1"/>
                    <footer>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>