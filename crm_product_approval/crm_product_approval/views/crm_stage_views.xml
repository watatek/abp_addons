<?xml version="1.0" encoding="UTF-8" ?>
<!-- Copyright 2026
     Adds the "Create Product" checkbox to the CRM Stage config form. -->
<odoo>

    <record id="view_crm_stage_form_create_product" model="ir.ui.view">
        <field name="name">crm.stage.form.create.product</field>
        <field name="model">crm.stage</field>
        <field name="inherit_id" ref="crm.crm_stage_form"/>
        <field name="arch" type="xml">
            <field name="is_won" position="after">
                <field name="create_product"/>
            </field>
        </field>
    </record>

    <record id="view_crm_stage_tree_create_product" model="ir.ui.view">
        <field name="name">crm.stage.list.create.product</field>
        <field name="model">crm.stage</field>
        <field name="inherit_id" ref="crm.crm_stage_tree"/>
        <field name="arch" type="xml">
            <field name="is_won" position="after">
                <field name="create_product" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
